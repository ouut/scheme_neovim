;;; =============================================================================
;;; 🚀 Steel Scheme IDE (All-in-One) 核心快捷键速查与实战试验田
;;; =============================================================================
;;; 欢迎使用 Steel Scheme 专属无模态（Modeless）开发环境！
;;; 本文件是开箱即用的快捷键速查手册与实战试验田。
;;; 所有的快捷键均支持在打字（插入模式）下直接按键生效，无需按 Esc！
;;;
;;; -----------------------------------------------------------------------------
;;; 📋 一、 现代通用快捷键速查表 (全模式直通生效)
;;; -----------------------------------------------------------------------------
;;; 1. 文件生命周期：
;;;    • Ctrl + S           : 保存当前文件 (Save)
;;;    • Ctrl + Q           : 安全退出 IDE (若有未保存修改，自动弹出确认提示)
;;;    • Ctrl + Shift + Q   : 强制退出 IDE (放弃修改直接退出)
;;;    • Ctrl + W           : 关闭当前文件标签页 (若只剩一个文件则安全退出)
;;;    • Ctrl + Z           : 撤销 (Undo)
;;;    • Ctrl + Y / Ctrl+⇧+Z: 重做 (Redo)
;;;    • Ctrl + A           : 全选 (Select All)
;;;    • Esc                : 取消选区 / 清除搜索高亮 (保持打字状态，不退出)
;;;
;;; 2. REPL 与终端管理：
;;;    • Alt + E / ⌥ E      : 发射求值 (一键将当前表达式送入 Steel REPL 求值)
;;;    • Alt + R / ⌥ R      : 一键秒开 / 秒关 Steel REPL 交互窗口
;;;    • Alt + T / ⌥ T      : 一键秒开 / 秒关 系统 Shell 终端 (Bash/PowerShell)
;;;
;;; 3. 全局窗口漫游与标签页切换：
;;;    • Alt + Shift + Up   : 聚焦上方代码编辑器
;;;    • Alt + Shift + Down : 聚焦右侧/下方终端或 REPL
;;;    • Alt + Shift + Left : 循环切换到左侧标签页 (回环)
;;;    • Alt + Shift + Right: 循环切换到右侧标签页 (回环)
;;;
;;; 4. 17 个 Strict Paredit 核心结构化按键：
;;;    • Alt + K / Alt + ⇧ + K : 向外扩选 (Expand) / 向内收缩 (Contract)
;;;    • Alt + H / Alt + ⇧ + H : 圆括号包裹 ( ) / 方括号包裹 [ ] (Calva 智能吸附)
;;;    • Alt + L / Alt + J     : 向右吞噬 (Slurp) / 向左吐出 (Barf)
;;;    • Alt + 2 / Alt + 1     : 大步前进 (Forward) / 大步后退 (Backward)
;;;    • Alt + W / Alt + S     : 步进深入 (Step Into) / 步退跳出 (Step Out)
;;;    • Alt + O / Alt + 3     : 脱壳解包 (Splice) / 选中顶级函数 (Defun)
;;;    • Alt + X / Alt + \     : 整块删除 (Kill Sexp) / 智能排版缩进 (Indent)
;;;    • Alt + ⇧ + L / Alt+⇧+J : 相邻参数对调 (Transpose) / 列表切分 (Split)
;;;
;;; =============================================================================
;;; 🧪 二、 实战交互演练区（光标移至下方代码，亲自敲击快捷键体验！）
;;; =============================================================================

;; -----------------------------------------------------------------------------
;; 演练 1：一键发射求值 (Alt + E 或 Space + Enter)
;; 将光标置于下方表达式中，按下 Alt + E，右侧将自动拉起 REPL 并输出结果：
;; -----------------------------------------------------------------------------
(+ 10 20 30)

(define (factorial n)
  (if (<= n 1)
      1
      (* n (factorial (- n 1)))))

(factorial 10)

;; -----------------------------------------------------------------------------
;; 演练 2：Calva 智能吸附包裹 (Alt + H 与 Alt + Shift + H)
;; ① 将光标移至 cards 后方或单词上，按下 Alt + H -> 自动变成 (cards)
;; ② 选中 x 10，按下 Alt + Shift + H -> 自动变成 [x 10]
;; -----------------------------------------------------------------------------
(define my-deck cards)

(define (test-bindings)
  (let* (x 10
         y 20)
    (+ x y)))

;; -----------------------------------------------------------------------------
;; 演练 3：向右吞噬 (Alt + L) 与 向左吐出 (Alt + J)
;; 光标在 (1 2) 内部：
;;   按 Alt + L: 右括号越过 3 -> 变成 (1 2 3) 4
;;   按 Alt + J: 吐出末尾 3   -> 还原为 (1 2) 3 4
;; -----------------------------------------------------------------------------
(define numbers
  '( (1 2) 3 4 ))

;; -----------------------------------------------------------------------------
;; 演练 4：相邻同胞对调 (Alt + Shift + L)
;; 光标置于 a 上，按下 Alt + Shift + L -> 变成 (equal? b a)
;; -----------------------------------------------------------------------------
(define (check-eq a b)
  (equal? a b))

;; -----------------------------------------------------------------------------
;; 演练 5：列表光标处切分 (Alt + Shift + J)
;; 光标置于 b 与 c 之间，按下 Alt + Shift + J -> 变成 (a b) (c d)
;; -----------------------------------------------------------------------------
'(a b c d)

;; -----------------------------------------------------------------------------
;; 演练 6：脱壳解包 (Alt + O)
;; 光标置于 (inner-function x) 内，按 Alt + O -> 剥除外壳，提取内部代码
;; -----------------------------------------------------------------------------
(define (wrapper x)
  (outer-function (inner-function x)))

;; -----------------------------------------------------------------------------
;; 演练 7：选中顶级函数 (Alt + 3)
;; 无论光标藏在函数内部多深，按下 Alt + 3 瞬间整块选中当前顶级 define！
;; -----------------------------------------------------------------------------
(define (deeply-nested-algorithm lst)
  (let ((filtered (filter (lambda (x) (> x 0)) lst)))
    (map (lambda (x) (* x 2))
         filtered)))

;; -----------------------------------------------------------------------------
;; 演练 8：纵向扩选 (Alt + K) 与 收缩 (Alt + Shift + K)
;; 光标在 filtered 上，连按 Alt + K 逐层向外扩选，按 Alt + Shift + K 逐层收缩！
;; -----------------------------------------------------------------------------

;; -----------------------------------------------------------------------------
;; 演练 9：首首大步跳转 (Alt + 2 前进，Alt + 1 后退)
;; 在下方列表中，按 Alt + 2 光标从 one 头跳到 two 头再跳到 three 头：
;; -----------------------------------------------------------------------------
'(one (nested two) three four)

